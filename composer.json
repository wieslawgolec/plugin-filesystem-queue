{
    "name": "wieslawgolec/plugin-filesystem-queue",
    "description": "Filesystem-based queue transport for Mautic 7 (email, hit, failed queues)",
    "type": "mautic-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Wieslaw Golec"
        }
    ],
    "require": {
        "php": "^8.1",
        "mautic/core-lib": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/messenger": "^7.0",
        "symfony/finder": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/dependency-injection": "^7.0"
    },
    "extra": {
        "mautic-plugin-name": "FileSystemQueueBundle"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\FileSystemQueueBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\FileSystemQueueBundle\\Tests\\": "tests/"
        },
        "files": [
            "tests/Stub/CoreParametersHelper.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}
